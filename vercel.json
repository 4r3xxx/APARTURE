{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "client",
      "framework": "nextjs"
    },
    "signaling": {
      "root": "server",
      "framework": "express",
      "entrypoint": "src/vercel.ts"
    }
  },
  "rewrites": [
    {
      "source": "/server/(.*)",
      "destination": { "service": "signaling" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
